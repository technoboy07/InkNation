# Copy to .env.local and fill in. For local development, `npx supabase status -o env` prints the Supabase values.

# Public address of the site, used in pairing QR codes. Set it to a LAN or tunnel URL when the
# studio runs on localhost, so the phone can reach it. Defaults to the address the browser used.
NEXT_PUBLIC_SITE_URL=

# Supabase: database, auth, realtime upload events
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Not read yet; the planned wiring for uploads and background removal.

# Cloudflare R2: private bucket for photos, designs and mockups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=inknation-uploads

# Modal: GPU fallback for background removal on devices without WebGPU
MODAL_CUTOUT_ENDPOINT=
MODAL_TOKEN=

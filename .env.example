# Copy to .env.local and fill in. For local development, `npx supabase status -o env` prints the Supabase values.

# Public address of the site, used in pairing QR codes. Set it to a LAN or tunnel URL when the
# studio runs on localhost, so the phone can reach it. Defaults to the address the browser used.
NEXT_PUBLIC_SITE_URL=

# Supabase: database, auth, realtime upload events
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# File storage: any S3-compatible bucket. Cloudflare R2 in production:
#   STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, STORAGE_S3_REGION=auto
#   The bucket needs a CORS rule allowing PUT and GET from the site's origin, with the Content-Type header.
# Locally, Supabase Storage stands in: `npx supabase status -o env` prints STORAGE_S3_URL and the
# S3_PROTOCOL_* keys, region "local". supabase/seed.sql creates the bucket.
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_BUCKET=inknation-uploads

# Not read yet; the planned wiring for background removal.
# Modal: GPU fallback for background removal on devices without WebGPU
MODAL_CUTOUT_ENDPOINT=
MODAL_TOKEN=
